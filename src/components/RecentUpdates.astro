---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  limit?: number;
}

const { posts, limit = 5 } = Astro.props;

// 获取最近更新的文章
const recentPosts = posts.slice(0, limit);
---

<div class="recent-updates">
  <h2 class="widget-title">
    <i class="fas fa-clock"></i>
    <span>最近更新</span>
  </h2>

  <div class="updates-list">
    {recentPosts.map((post) => {
      const postSlug = post.id
        .replace(/\.mdx?$/, '')
        .replace(/\s+/g, '-')
        .toLowerCase();

      return (
        <a href={`/blog/${postSlug}/`} class="update-item">
          <div class="update-content">
            <h3 class="update-title">{post.data.title}</h3>
            <time class="update-date">
              <FormattedDate date={post.data.pubDate} />
            </time>
          </div>
        </a>
      );
    })}
  </div>

  {recentPosts.length === 0 && (
    <div class="empty-state">
      <p>暂无文章</p>
    </div>
  )}
</div>

<style>
  .recent-updates {
    background-color: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
  }

  .widget-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-color);
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-color);
  }

  .widget-title i {
    color: var(--primary-color);
  }

  .updates-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .update-item {
    display: block;
    padding: 0.75rem;
    border-radius: var(--border-radius);
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .update-item:hover {
    background-color: var(--hover-bg);
  }

  .update-content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .update-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-color);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .update-item:hover .update-title {
    color: var(--primary-color);
  }

  .update-date {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .empty-state {
    text-align: center;
    padding: 2rem 0;
    color: var(--text-muted);
  }

  .empty-state p {
    margin: 0;
    font-size: 0.9rem;
  }

  /* 响应式设计 */
  @media (max-width: 768px) {
    .recent-updates {
      padding: 1.25rem;
    }

    .widget-title {
      font-size: 1rem;
    }

    .update-item {
      padding: 0.625rem;
    }

    .update-title {
      font-size: 0.875rem;
    }

    .update-date {
      font-size: 0.75rem;
    }
  }
</style>
