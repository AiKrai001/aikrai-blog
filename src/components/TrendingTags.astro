---
import type { CollectionEntry } from 'astro:content';
import { encodePathSegmentSafe } from '../utils/safeSlug';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  limit?: number;
}

const { posts, limit = 10 } = Astro.props;

// 统计所有标签及其出现次数
const tagCounts = new Map<string, number>();

posts.forEach((post) => {
  if (post.data.tags) {
    post.data.tags.forEach((tag: string) => {
      tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    });
  }
});

// 按出现次数排序并获取前N个标签
const trendingTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, limit)
  .map(([tag, count]) => ({ tag, count }));
---

<div class="trending-tags">
  <h2 class="widget-title">
    <i class="fas fa-fire"></i>
    <span>热门标签</span>
  </h2>

  <div class="tags-cloud">
    {trendingTags.map(({ tag, count }) => (
      <a
        href={`/tags/${encodePathSegmentSafe(tag)}/`}
        class="tag-item"
        data-count={count}
      >
        <span class="tag-name">{tag}</span>
        <span class="tag-count">{count}</span>
      </a>
    ))}
  </div>

  {trendingTags.length === 0 && (
    <div class="empty-state">
      <p>暂无标签</p>
    </div>
  )}
</div>

<style>
  .trending-tags {
    background-color: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .widget-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-color);
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-color);
  }

  .widget-title i {
    color: var(--primary-color);
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    background-color: var(--tag-bg);
    color: var(--tag-color);
    font-size: 0.8rem;
    border-radius: var(--border-radius-full);
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }

  .tag-item:hover {
    background-color: var(--tag-hover-bg);
    color: var(--primary-color);
    border-color: var(--primary-color);
    transform: translateY(-2px);
  }

  .tag-name {
    font-weight: 500;
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    background-color: var(--primary-color);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: var(--border-radius-full);
  }

  /* 根据标签数量调整大小 */
  .tag-item[data-count="1"],
  .tag-item[data-count="2"] {
    font-size: 0.75rem;
  }

  .tag-item[data-count="3"],
  .tag-item[data-count="4"],
  .tag-item[data-count="5"] {
    font-size: 0.8rem;
  }

  .tag-item[data-count]:not([data-count="1"]):not([data-count="2"]):not([data-count="3"]):not([data-count="4"]):not([data-count="5"]) {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .empty-state {
    text-align: center;
    padding: 2rem 0;
    color: var(--text-muted);
  }

  .empty-state p {
    margin: 0;
    font-size: 0.9rem;
  }

  /* 响应式设计 */
  @media (max-width: 768px) {
    .trending-tags {
      padding: 1.25rem;
    }

    .widget-title {
      font-size: 1rem;
    }

    .tag-item {
      font-size: 0.8rem;
      padding: 0.375rem 0.75rem;
    }

    .tag-count {
      min-width: 1.25rem;
      height: 1.25rem;
      font-size: 0.7rem;
    }
  }
</style>
