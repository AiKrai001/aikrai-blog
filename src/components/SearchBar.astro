---
// 搜索栏组件
---

<div class="search-container">
  <div class="search-box">
    <i class="fas fa-search search-icon"></i>
    <input
      type="text"
      id="search-input"
      class="search-input"
      placeholder="搜索..."
      autocomplete="off"
    />
    <button id="clear-search" class="clear-btn" aria-label="清除搜索">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <!-- 搜索结果下拉框 -->
  <div id="search-results" class="search-results hidden">
    <div class="search-results-list"></div>
    <div class="search-no-results hidden">
      <p>未找到相关结果</p>
    </div>
  </div>
</div>

<style>
  .search-container {
    position: relative;
    margin-bottom: 2rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    background-color: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    transition: all 0.3s ease;
  }

  .search-box:focus-within {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
  }

  .search-icon {
    color: var(--text-muted);
    margin-right: 0.75rem;
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text-color);
    font-size: 0.9rem;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .clear-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    transition: color 0.3s ease;
  }

  .clear-btn:hover {
    color: var(--primary-color);
  }

  .clear-btn.show {
    display: block;
  }

  .search-results {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background-color: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: var(--shadow);
    max-height: 400px;
    overflow-y: auto;
    z-index: 100;
  }

  .search-results.hidden {
    display: none;
  }

  .search-results-list {
    padding: 0.5rem;
  }

  .search-result-item {
    padding: 0.75rem 1rem;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-bottom: 0.5rem;
  }

  .search-result-item:hover {
    background-color: var(--hover-bg);
  }

  .search-result-item:last-child {
    margin-bottom: 0;
  }

  .search-result-title {
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 0.25rem;
  }

  .search-result-excerpt {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-no-results {
    padding: 2rem;
    text-align: center;
    color: var(--text-muted);
  }

  .search-no-results.hidden {
    display: none;
  }

  /* 高亮搜索关键词 */
  .highlight {
    background-color: rgba(79, 70, 229, 0.2);
    color: var(--primary-color);
    font-weight: 600;
    padding: 0 0.125rem;
    border-radius: 2px;
  }
</style>

<script>
  // 搜索功能实现
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('clear-search');
    const searchResults = document.getElementById('search-results');
    const searchResultsList = searchResults?.querySelector('.search-results-list');
    const searchNoResults = searchResults?.querySelector('.search-no-results');

    if (!searchInput || !clearBtn || !searchResults || !searchResultsList || !searchNoResults) {
      return;
    }

    // 从全局变量获取搜索数据
    const posts = (window as any).searchData || [];

    // 搜索函数
    function search(query: string) {
      const lowerQuery = query.toLowerCase().trim();

      if (!lowerQuery) {
        searchResults.classList.add('hidden');
        return;
      }

      const results = posts.filter((post: any) => {
        return (
          post.title.toLowerCase().includes(lowerQuery) ||
          post.description.toLowerCase().includes(lowerQuery) ||
          (post.tags && post.tags.some((tag: string) => tag.toLowerCase().includes(lowerQuery)))
        );
      });

      displayResults(results, lowerQuery);
    }

    // 显示搜索结果
    function displayResults(results: any[], query: string) {
      searchResultsList.innerHTML = '';

      if (results.length === 0) {
        searchNoResults.classList.remove('hidden');
        searchResults.classList.remove('hidden');
        return;
      }

      searchNoResults.classList.add('hidden');

      results.forEach((post: any) => {
        const item = document.createElement('div');
        item.className = 'search-result-item';

        const title = highlightText(post.title, query);
        const excerpt = highlightText(post.description || '', query);

        item.innerHTML = `
          <div class="search-result-title">${title}</div>
          <div class="search-result-excerpt">${excerpt || '暂无描述'}</div>
        `;

        item.addEventListener('click', () => {
          window.location.href = `/blog/${post.slug}/`;
        });

        searchResultsList.appendChild(item);
      });

      searchResults.classList.remove('hidden');
    }

    // 高亮关键词
    function highlightText(text: string, query: string): string {
      if (!text) return '';
      const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
      return text.replace(regex, '<span class="highlight">$1</span>');
    }

    // 转义正则表达式特殊字符
    function escapeRegex(str: string): string {
      return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // 输入事件
    let searchTimeout: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', (e) => {
      const value = (e.target as HTMLInputElement).value;

      if (value) {
        clearBtn.classList.add('show');
      } else {
        clearBtn.classList.remove('show');
        searchResults.classList.add('hidden');
      }

      // 防抖
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        search(value);
      }, 300);
    });

    // 清除按钮
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      clearBtn.classList.remove('show');
      searchResults.classList.add('hidden');
    });

    // 点击外部关闭搜索结果
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (searchResults && !searchResults.contains(target) && target !== searchInput) {
        searchResults.classList.add('hidden');
      }
    });
  });
</script>
